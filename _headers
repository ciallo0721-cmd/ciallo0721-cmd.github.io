/*
  # ⚠️ 重要说明（安全审计 2026-08-21 修正）：
  #   _headers 是 Cloudflare Pages / Cloudflare CDN 的功能，
  #   当前部署在 GitHub Pages，此文件不会被读取，以下安全头在线上全部未生效！
  #   GitHub Pages 无法自定义响应头，如需让这些头真正生效，请：
  #     方案A：迁移到 Cloudflare Pages（CNAME + _headers + _worker_cf.js 直接可用）
  #     方案B：域名接入 Cloudflare 免费 CDN 代理（DNS 托管到 CF，在转化规则里加头）
  #     方案C：接受 GitHub Pages 现状，仅靠页面内 meta 标签做缓解（能力有限）
  #
  # 防点击劫持：禁止本站被嵌入 iframe
  X-Frame-Options: SAMEORIGIN

  # 防 MIME 类型嗅探攻击
  X-Content-Type-Options: nosniff

  # 强制启用 XSS 过滤（旧浏览器兼容）
  X-XSS-Protection: 1; mode=block

  # 引用来源策略：仅发送 origin，不泄露完整 URL
  Referrer-Policy: strict-origin-when-cross-origin

  # 权限策略：禁用不必要的浏览器特性
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # HTTP 严格传输安全（需站点全站 HTTPS，Cloudflare 部署时生效）
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy (SEO-安全平衡版)
  # 说明：
  #   - default-src 'self'                                   默认仅允许同源资源
  #   - script-src 'self' 'unsafe-inline'                    保留内联脚本（decoder.js、GA 等需要）
  #     ★ 已移除 'unsafe-eval'（安全审计修正）：admin 控制台用 <script> 注入执行，
  #       不依赖 eval/new Function，移除后 XSS 场景下 eval 类攻击会被 CSP 拦截。
  #   - style-src 'self' 'unsafe-inline' cdnjs.cloudflare.com
  #   - font-src 'self' cdnjs.cloudflare.com data:
  #   - img-src 'self' data: blob:
  #   - media-src 'self'
  #   - frame-src 'self'
  #   - connect-src 'self' https://api.ip.sb                     允许同源 XHR + 访客追踪公网 IP 查询
  #   - object-src 'none'
  #   - base-uri 'self'
  #   - form-action 'self'
  #
  #   注意: 'unsafe-inline' 对 Googlebot 的渲染管线至关重要，因为 decoder 使用内联 JS 加载文章。
  #   如果没有 unsafe-inline，Googlebot 的 headless Chrome 将无法执行任何脚本，
  #   导致页面被判定为无内容（"Crawled but not indexed"）。
  #
  #   Turnstile（oops/turnstile/ 验证页）需要 challenges.cloudflare.com：
  #   script-src 加载 api.js；frame-src 加载验证码 iframe；style/img/connect 供 widget 渲染与通信。
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://challenges.cloudflare.com https://cloud.umami.is; style-src 'self' 'unsafe-inline' cdnjs.cloudflare.com https://challenges.cloudflare.com; font-src 'self' cdnjs.cloudflare.com data:; img-src 'self' data: blob: https://challenges.cloudflare.com https://www.youtube.com; media-src 'self'; frame-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://www.google-analytics.com https://api.ip.sb https://v1.hitokoto.cn https://challenges.cloudflare.com https://www.youtube.com https://cloud.umami.is; object-src 'none'; base-uri 'self'; form-action 'self';

  # 性能优化：缓存策略
  # 静态资源缓存1年
  Cache-Control: public, max-age=31536000, immutable

# 媒体文件
*.png, *.jpg, *.jpeg, *.gif, *.webp, *.svg, *.ico
  Cache-Control: public, max-age=31536000, immutable

# 字体文件
*.woff, *.woff2, *.ttf, *.otf, *.eot
  Cache-Control: public, max-age=31536000, immutable

# 音频文件
*.mp3, *.ogg, *.wav, *.m4a
  Cache-Control: public, max-age=2592000

# HTML文件 - 不缓存，确保最新内容
*.html, *.htm
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# 文本文件 - 短缓存，便于 IndexNow key 更新
*.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# JSON文件
*.json
  Cache-Control: public, max-age=86400

# JavaScript文件 - 长期缓存
*.js
  Cache-Control: public, max-age=31536000, immutable

