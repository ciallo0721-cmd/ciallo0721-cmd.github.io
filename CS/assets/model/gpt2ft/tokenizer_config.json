{
  "backend": "tokenizers",
  "cls_token": "[CLS]",
  "do_lower_case": false,
  "extra_special_tokens": [
    "<|user|>",
    "<|assistant|>",
    "<|end|>"
  ],
  "is_local": false,
  "local_files_only": false,
  "mask_token": "[MASK]",
  "model_max_length": 1024,
  "pad_token": "[PAD]",
  "sep_token": "[SEP]",
  "strip_accents": null,
  "tokenize_chinese_chars": true,
  "tokenizer_class": "BertTokenizer",
  "unk_token": "[UNK]"
}
